import GHS.ExtendedRejectionMCS

/-!
# The extended-domain converse in the paper's original cost variable

This file uses Fenchel--Moreau to rewrite the conjugate-of-conjugate cost in
`GHS.ExtendedRejectionMCS` as the original closed proper convex cost.
-/

open Set

namespace GHS

variable {n : ℕ}

local notation "V" => Fin n → ℝ

/-- A proper `EReal` cost represented in the paper's `WithTop ℝ` value type. -/
noncomputable def properCostTop (c : V → EReal)
    (hc : ProperConvexFunctionOn Set.univ c) (q : V) : ERealTop :=
  (c q).unbot (hc.2.2 q (Set.mem_univ q))

private theorem toE_eq_withBotCoe_cost (a : ERealTop) :
    toE a = WithBot.some a := by
  induction a using WithTop.recTopCoe with
  | top => rfl
  | coe r => rfl

@[simp] theorem toE_properCostTop {c : V → EReal}
    (hc : ProperConvexFunctionOn Set.univ c) (q : V) :
    toE (properCostTop c hc q) = c q := by
  rw [toE_eq_withBotCoe_cost]
  exact WithBot.coe_unbot _ _

/-- Rejected bundles written with the original extended-real cost. -/
def properCostRejections (c : V → EReal)
    (hc : ProperConvexFunctionOn Set.univ c) (p qb : V) : Set V :=
  argminOn (fun u => properCostTop c hc (qb - u) +
    ((p ⬝ᵥ u : ℝ) : ERealTop)) {v | 0 ≤ v}

/-- Fenchel--Moreau identifies the cost obtained by conjugating `c*` with the
original closed proper cost `c`, including at points where the value is `+∞`. -/
theorem properCostTop_eq_extendedDualCostTop_conjugate {c : V → EReal}
    (hc_lsc : LowerSemicontinuous c)
    (hc : ProperConvexFunctionOn Set.univ c) (q : V) :
    properCostTop c hc q =
      extendedDualCostTop (fenchelConjugate n c)
        (fenchelConjugate_proper hc_lsc hc) q := by
  apply le_antisymm
  · rw [← toE_le_toE, toE_properCostTop, toE_extendedDualCostTop,
      fenchelConjugate_biconjugate hc_lsc hc]
  · rw [← toE_le_toE, toE_properCostTop, toE_extendedDualCostTop,
      fenchelConjugate_biconjugate hc_lsc hc]

/-- The original-cost rejection correspondence equals the rejection
correspondence generated from the conjugate's Fenchel dual. -/
theorem properCostRejections_eq_extendedSubdiffRejections {c : V → EReal}
    (hc_lsc : LowerSemicontinuous c)
    (hc : ProperConvexFunctionOn Set.univ c) (p qb : V) :
    properCostRejections c hc p qb =
      extendedSubdiffRejections (fenchelConjugate n c)
        (fenchelConjugate_proper hc_lsc hc) p qb := by
  unfold properCostRejections extendedSubdiffRejections
  congr 1
  funext u
  rw [properCostTop_eq_extendedDualCostTop_conjugate hc_lsc hc]

/-- **GHS Theorem 2, converse with a sublattice conjugate domain.** Let `c` be
closed proper convex and suppose the effective domain of `c*` is a sublattice.
If the projected rejection comparison holds for the argmin rejection
correspondence generated by `c`, then `c*` is submodular. -/
theorem pOrderE_fenchelConjugate_of_rejection_order_sublattice
    {c : V → EReal}
    (hc_lsc : LowerSemicontinuous c)
    (hc : ProperConvexFunctionOn Set.univ c)
    (hDl : Correspondence.IsPriceSublattice
      (effectiveDomain Set.univ (fenchelConjugate n c)))
    (hR : ∀ p ∈ intrinsicInterior ℝ
        (effectiveDomain Set.univ (fenchelConjugate n c)),
      ∀ p' ∈ intrinsicInterior ℝ
        (effectiveDomain Set.univ (fenchelConjugate n c)),
      p ≤ p' → ∀ qb,
        QOrderSet
          (projectedSet {i | p i = p' i} (properCostRejections c hc p qb))
          (projectedSet {i | p i = p' i} (properCostRejections c hc p' qb))) :
    POrderE (fenchelConjugate n c) (fenchelConjugate n c) := by
  have hcstarProper := fenchelConjugate_proper hc_lsc hc
  have hcstarLsc := (fenchelConjugate_closedConvex n c).1
  apply pOrderE_of_extendedSubdiffRejection_order hcstarProper hcstarLsc hDl
  intro p hp p' hp' hpp' qb
  rw [← properCostRejections_eq_extendedSubdiffRejections hc_lsc hc,
    ← properCostRejections_eq_extendedSubdiffRejections hc_lsc hc]
  exact hR p hp p' hp' hpp' qb

end GHS
