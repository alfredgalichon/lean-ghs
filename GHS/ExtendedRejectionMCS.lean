import GHS.ExtendedRejectionOrder
import GHS.ExtendedFenchelRejections

/-!
# Extended-valued rejection monotonicity implies submodularity

This file combines the rejection-order bridge with the extended-domain
submodularity theorem.
-/

open Set

namespace GHS

variable {n : ℕ}

local notation "V" => Fin n → ℝ

/-- Rejection monotonicity on the relative interior of a sublattice effective
domain implies extended-real submodularity.  The hypothesis is stated using
the rejection representation by relative subgradients, so the only remaining
application-specific bridge is the Fenchel--Young identification with the
paper's argmin correspondence. -/
theorem pOrderE_of_relativeSubdiffRejection_order {φ : V → EReal}
    (hproper : ProperConvexFunctionOn Set.univ φ)
    (hlsc : LowerSemicontinuous φ)
    (hDl : Correspondence.IsPriceSublattice (effectiveDomain Set.univ φ))
    (hR : ∀ p ∈ intrinsicInterior ℝ (effectiveDomain Set.univ φ),
      ∀ p' ∈ intrinsicInterior ℝ (effectiveDomain Set.univ φ), p ≤ p' → ∀ qb,
        QOrderSetD {i | p i = p' i}
          (relativeSubdiffRejections (effectiveDomain Set.univ φ) (finitePart φ) p qb)
          (relativeSubdiffRejections (effectiveDomain Set.univ φ) (finitePart φ) p' qb)) :
    POrderE φ φ := by
  let D := effectiveDomain Set.univ φ
  let f := finitePart φ
  have hbot : ∀ x, φ x ≠ ⊥ := fun x => hproper.2.2 x (Set.mem_univ x)
  have hf : ConvexOn ℝ D f := convexOn_finitePart hproper.1 hbot
  have hD : Convex ℝ D := hf.1
  have hne : ∀ p ∈ intrinsicInterior ℝ D,
      ∃ s, Correspondence.SubgradOn D f p s :=
    fun p hp => Correspondence.exists_subgrad_of_mem_ri hD hf hp
  apply pOrderE_of_KCpairOn_intrinsicInterior hproper hlsc hDl
  exact KCpairOn_of_relativeSubdiffRejection_order hne hR

/-- **Extended-domain converse for the argmin rejection correspondence.**
For a closed proper convex `φ` with sublattice effective domain, projected
Q-monotonicity of the rejection sets generated by the conjugate cost implies
that `φ` is submodular. -/
theorem pOrderE_of_extendedSubdiffRejection_order {φ : V → EReal}
    (hproper : ProperConvexFunctionOn Set.univ φ)
    (hlsc : LowerSemicontinuous φ)
    (hDl : Correspondence.IsPriceSublattice (effectiveDomain Set.univ φ))
    (hR : ∀ p ∈ intrinsicInterior ℝ (effectiveDomain Set.univ φ),
      ∀ p' ∈ intrinsicInterior ℝ (effectiveDomain Set.univ φ), p ≤ p' → ∀ qb,
        QOrderSet
          (projectedSet {i | p i = p' i}
            (extendedSubdiffRejections φ hproper p qb))
          (projectedSet {i | p i = p' i}
            (extendedSubdiffRejections φ hproper p' qb))) :
    POrderE φ φ := by
  let D := effectiveDomain Set.univ φ
  let f := finitePart φ
  have hbot : ∀ x, φ x ≠ ⊥ := fun x => hproper.2.2 x (Set.mem_univ x)
  have hf : ConvexOn ℝ D f := convexOn_finitePart hproper.1 hbot
  have hD : Convex ℝ D := hf.1
  have hne : ∀ p ∈ intrinsicInterior ℝ D,
      ∃ s, Correspondence.SubgradOn D f p s :=
    fun p hp => Correspondence.exists_subgrad_of_mem_ri hD hf hp
  apply pOrderE_of_KCpairOn_intrinsicInterior hproper hlsc hDl
  intro p hp p' hp' hpp'
  obtain ⟨σ, hσ⟩ := hne p hp
  obtain ⟨τ₀, hτ₀⟩ := hne p' hp'
  let qb : V := σ ⊔ τ₀
  have hσqb : σ ≤ qb := le_sup_left
  have hτ₀qb : τ₀ ≤ qb := le_sup_right
  have hσR : qb - σ ∈ extendedSubdiffRejections φ hproper p qb :=
    (mem_extendedSubdiffRejections_iff hproper (intrinsicInterior_subset hp)
      hσ hσqb).2 ⟨fun i => sub_nonneg.mpr (hσqb i), by
        simpa only [sub_sub_cancel] using hσ⟩
  have hτ₀R : qb - τ₀ ∈ extendedSubdiffRejections φ hproper p' qb :=
    (mem_extendedSubdiffRejections_iff hproper (intrinsicInterior_subset hp')
      hτ₀ hτ₀qb).2 ⟨fun i => sub_nonneg.mpr (hτ₀qb i), by
        simpa only [sub_sub_cancel] using hτ₀⟩
  obtain ⟨u', hu'R, hdom⟩ := projectedQOrder_exists_ge_on
    (hR p hp p' hp' hpp' qb) ⟨qb - σ, hσR⟩ ⟨qb - τ₀, hτ₀R⟩
      (qb - σ) hσR
  have hu' := (mem_extendedSubdiffRejections_iff hproper
    (intrinsicInterior_subset hp') hτ₀ hτ₀qb).1 hu'R
  refine ⟨σ, qb - u', hσ, hu'.2, ?_⟩
  intro i hi
  have hui := hdom i hi
  change qb i - σ i ≤ u' i at hui
  change qb i - u' i ≤ σ i
  linarith

end GHS
