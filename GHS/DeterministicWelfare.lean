import GHS.RandomUtility
import GHS.SubdiffOrder

/-!
# Deterministic aggregate welfare and finite choice

This file verifies two bridge claims used in Section 3 of the revised GHS
paper: deterministic aggregate welfare is submodular, and at finite utility
vectors the conjugate argmax correspondence is the ordinary subdifferential.
-/

namespace GHS

variable {I J : Type*} [Fintype I] [Fintype J]

/-- Aggregate deterministic welfare, with an outside option for every type. -/
noncomputable def deterministicAggregateWelfare
    (mass : I → ℝ) (outside : I → ℝ) (inside : I → J → ℝ)
    (U : I × J → ℝ) : ℝ :=
  ∑ i, mass i * randomUtilityMax
    (fun i' (o : Option J) => o.elim (outside i') (inside i'))
      (fun j => U (i, j)) i

/-- The aggregate deterministic welfare function is submodular whenever the
type masses are nonnegative. This applies to both `G₀` and `H₀`. -/
theorem deterministicAggregateWelfare_submodular
    (mass : I → ℝ) (hmass : ∀ i, 0 ≤ mass i)
    (outside : I → ℝ) (inside : I → J → ℝ) :
    Submodular (fun U : I × J → ℝ =>
      ((deterministicAggregateWelfare mass outside inside U : ℝ) : ERealTop)) := by
  intro U V
  rw [← WithTop.coe_add, ← WithTop.coe_add, WithTop.coe_le_coe]
  simp only [deterministicAggregateWelfare]
  rw [← Finset.sum_add_distrib, ← Finset.sum_add_distrib]
  apply Finset.sum_le_sum
  intro i hi
  have h := randomUtilityMax_submodular
    (fun i' (o : Option J) => o.elim (outside i') (inside i')) i
      (fun j => U (i, j)) (fun j => V (i, j))
  have hm := mul_le_mul_of_nonneg_left h (hmass i)
  simpa [Pi.inf_apply, Pi.sup_apply, ← mul_add] using hm

section FiniteChoice

variable {n : ℕ}

/-- The choice set generated by the conjugate objective of a finite convex
function. -/
def finiteChoice (G : (Fin n → ℝ) → ℝ) (U : Fin n → ℝ) : Set (Fin n → ℝ) :=
  {μ | ∀ ν,
    ((ν ⬝ᵥ U : ℝ) : EReal) - subdiffCost G ν ≤
      ((μ ⬝ᵥ U : ℝ) : EReal) - subdiffCost G μ}

/-- The ordinary vector subdifferential of a finite convex function. -/
def finiteSubdifferential (G : (Fin n → ℝ) → ℝ) (U : Fin n → ℝ) :
    Set (Fin n → ℝ) :=
  {μ | Subgradient G U μ}

/-- For finite utility vectors, the conjugate argmax correspondence is the
ordinary subdifferential: `C^G(U) = ∂G(U)`. -/
theorem finiteChoice_eq_finiteSubdifferential
    (G : (Fin n → ℝ) → ℝ) (hG : ConvexOn ℝ Set.univ G) (U : Fin n → ℝ) :
    finiteChoice G U = finiteSubdifferential G U := by
  ext μ
  exact (subgradient_iff_argmax hG U μ).symm

end FiniteChoice

end GHS
